{
  "name": "mongoadvisor",
  "version": "0.1.0-beta",
  "description": "Observability tool for MongoDB clusters",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "atlas:create-user": "node scripts/atlas-create-db-user.js",
    "indexes:ensure": "node scripts/ensure-indexes.js",
    "decrypt:field": "node scripts/decrypt-field.js",
    "workload:fast": "node scripts/workload-fast.js",
