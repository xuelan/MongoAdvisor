# MongoAdvisor application database (stores clusters, metrics, reports — NOT monitored cluster URIs)
#
# Option A — Atlas (recommended for production live monitoring):
# MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/mongoadvisor?authSource=admin
#
# Option B — local Docker, no cloud Atlas for app DB (offline reports / local dev):
#   docker run -p 27017:27017 -v mongoadvisor-local-data:/data/db -d mongodb/mongodb-atlas-local:latest
#   See https://www.mongodb.com/docs/atlas/cli/current/atlas-cli-deploy-docker/
# MONGO_URI=mongodb://127.0.0.1:27017/mongoadvisor?directConnection=true
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/mongoadvisor
MONGO_DB=mongoadvisor

# Optional: cluster where sample_airbnb / sample_mflix live for workload-* and airbnb-expand-listings-big.js
# If unset, those scripts use MONGO_URI. Monitored production URIs are registered in the UI, not here.
# Create user: npm run atlas:create-user -- --preset workload ... --username mongoadvisor_workload (see README)
# WORKLOAD_MONGO_URI=mongodb+srv://mongoadvisor_workload:<password>@<host>/?authSource=admin

# Server
PORT=3000

# Slow-query collector window (per-host watermark)
# SAFETY_LAG: re-fetch this far behind the latest stored row each poll, covering Atlas log delay
# MAX_LOOKBACK: hard cap on the request window (also used on first run / after long outages)
# SLOW_QUERY_SAFETY_LAG_MS=60000
# SLOW_QUERY_MAX_LOOKBACK_MS=1800000

# Retention — see docs/retention.md
# Raw collections (query_stats, slow_queries, disk_usage, oplog_window, monitor_logs)
# are TTL-purged after RETENTION_RAW_DAYS + 1 day. Before they expire, the hourly
# rollup job aggregates each closed hour into *_hourly collections. Set
# RETENTION_HOURLY_DAYS=0 to keep rollup history forever.
# RETENTION_ENABLED=true
# RETENTION_RAW_DAYS=7
# RETENTION_HOURLY_DAYS=0
# ROLLUP_INTERVAL_MS=3600000
# ROLLUP_SAFETY_BUFFER_HOURS=2

# Encryption key for stored credentials (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
ENCRYPTION_KEY=

# Optional: GET /api/atlas/database-users/defaults returns these (scripts/curl only — never put the private API key in env)
# ATLAS_BACKEND_PROJECT_ID=
# ATLAS_BACKEND_PUBLIC_KEY=

# Optional: workload scripts (higher = slower, more realistic scan)
# READ_PREF=primary
# MFLIX_EMBEDDED_CAP=400
# MFLIX_LOOKUP_CAP=45
# MFLIX_OUTLIER_CAP=1800
# AIRBNB_DOC_CAP=80
# AIRBNB_LOOKUP_CAP=8
# AIRBNB_SEASON_CAP=1200
